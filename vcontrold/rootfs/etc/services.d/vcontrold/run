#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start vcontrold service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

bashio::log.info "VControld starting...."

# Render vcontrold.xml from template using the configured device path
tempio \
    -template /etc/vcontrold/vcontrold.xml.gtpl \
    -out /etc/vcontrold/vcontrold.xml \
    -conf /data/options.json

bashio::log.info "Using device: $(bashio::config 'device')"

exec /usr/bin/run-vito
